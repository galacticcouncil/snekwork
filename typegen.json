{
  "outDir": "src/types",
  "specVersions": "typegen/basiliskVersions.jsonl",
  "typesBundle": "typegen/basilisk-types.json",
  "pallets": {
    "AssetRegistry": {
      "storage": ["Assets", "AssetMetadataMap", "AssetLocations", "AssetIds", "NextAssetId"],
      "events": ["Registered", "Updated", "MetadataSet", "LocationSet"]
    },
    "XYK": {
      "storage": ["PoolAssets", "TotalLiquidity", "ShareToken"],
      "events": ["PoolCreated", "PoolDestroyed", "SellExecuted", "BuyExecuted", "LiquidityAdded", "LiquidityRemoved"]
    },
    "LBP": {
      "storage": ["PoolData"],
      "events": ["PoolCreated", "PoolUpdated", "SellExecuted", "BuyExecuted", "LiquidityAdded", "LiquidityRemoved"]
    },
    "Broadcast": {
      "events": ["Swapped", "Swapped3"]
    },
    "Exchange": {
      "events": [
        "IntentionRegistered",
        "IntentionResolvedAMMTrade",
        "IntentionResolvedDirectTrade",
        "IntentionResolvedDirectTradeFees"
      ]
    },
    "XYKLiquidityMining": {
      "events": ["SharesDeposited", "SharesRedeposited", "SharesWithdrawn", "RewardClaimed"]
    },
    "XYKWarehouseLM": {
      "storage": ["GlobalFarm", "YieldFarm", "Deposit", "ActiveYieldFarm"],
      "events": ["GlobalFarmAccRPZUpdated", "YieldFarmAccRPVSUpdated"]
    },
    "Tokens": {
      "storage": ["Accounts", "TotalIssuance"],
      "events": ["Transfer", "Deposited", "Withdrawn", "BalanceSet", "Endowed", "DustLost", "Reserved", "Unreserved"]
    },
    "Balances": {
      "storage": ["Account", "TotalIssuance"],
      "events": ["Transfer", "Deposit", "Withdraw", "BalanceSet", "Endowed", "DustLost", "Reserved", "Unreserved"]
    },
    "Currencies": {
      "events": ["Transferred", "BalanceUpdated", "Deposited", "Withdrawn"]
    },
    "System": {
      "storage": ["Account"],
      "calls": ["set_storage"]
    }
  }
}
