{
  "name": "snekwork",
  "version": "1.0.0",
  "description": "Snekwork Basilisk explorer data platform",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "start:raw": "tsx src/raw/cli.ts",
    "detect-gaps": "tsx src/cli.ts --detect-gaps",
    "repair:volume": "tsx src/scripts/repair-volume.ts",
    "validate:raw-balances": "tsx src/scripts/validate-raw-balances.ts",
    "snapshot:balances": "tsx src/scripts/snapshot-balances.ts",
    "snapshot:identities": "tsx src/scripts/snapshot-identities.ts",
    "test": "vitest run",
    "typegen:bundle": "tsx src/scripts/write-typegen-bundle.ts",
    "typegen": "npm run typegen:bundle && squid-substrate-typegen typegen.json && tsx src/scripts/patch-typegen-support.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:all": "npm run check && npm --prefix api run check && npm --prefix explorer-ui run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galacticcouncil/snekwork.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/galacticcouncil/snekwork/issues"
  },
  "homepage": "https://github.com/galacticcouncil/snekwork#readme",
  "dependencies": {
    "@clickhouse/client": "^1.16.0",
    "@polkadot/util": "^14.0.1",
    "@polkadot/util-crypto": "^14.0.1",
    "@subsquid/rpc-client": "4.15.0",
    "@subsquid/substrate-processor": "^8.8.1",
    "@subsquid/substrate-runtime": "^2.0.1",
    "@subsquid/util-internal-processor-tools": "4.4.0",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@subsquid/substrate-typegen": "^8.1.0",
    "@types/node": "^25.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
